    "tracks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "file", "license"], "properties": {"id": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "moods": {"type": "array", "items": {"type": "string"}}, "genres": {"type": "array", "items": {"type": "string"}}, "commercial": {"type": "boolean"}, "bpm": {"type": "number", "exclusiveMinimum": 0}, "vocal": {"type": "boolean"}}}}
  }
}
